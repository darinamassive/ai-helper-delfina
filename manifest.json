{
  "manifest_version": 3,
  "name": "Video Speed",
  "description": "Изменение скорости видео на текущей вкладке",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Скорость видео",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
